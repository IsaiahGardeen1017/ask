{
  "tasks": {
    "build-all": "deno task build-exe && deno task build-win-uns && deno task build-win-ins",
    "build-exe": "deno compile --output ask.exe --allow-net --allow-env --allow-read --allow-write src/idx/windows.ts",
    "build-win-ins": "deno compile --output ask-windows-install.exe --allow-net --allow-env --allow-read --allow-write --unstable-raw-imports --allow-run installer/windows_install.ts",
    "build-win-uns": "deno compile --output ask-windows-uninstall.exe --allow-net --allow-env --allow-read --allow-write --allow-run installer/windows_uninstall.ts",
    "dev": "deno run --allow-net --allow-read --allow-write src/idx/development.ts",
    "windows": "deno run --allow-net --allow-read --allow-write --allow-env src/idx/windows.ts",
    "install": "deno run --allow-read --allow-write --allow-env --allow-run --unstable-raw-imports installer/windows_install.ts",
    "uninstall": "deno run --allow-read --allow-write --allow-env --allow-run --unstable-raw-imports installer/windows_uninstall.ts",
    "md": "deno run -A src/markdowner.test.ts",
    "clear": "rm -rf src/supertonic/assets/outdir/*"
  },
  "imports": {},
  "fmt": {
    "options": {
      "useTabs": true,
      "singleQuote": true,
      "proseWrap": "never",
      "lineWidth": 135
    }
  }
}